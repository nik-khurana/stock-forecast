# Alpaca API Credentials (Paper Trading)
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here

# Alpaca Endpoints
# Paper Trading base URL:
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Market Data API v2 endpoint (same for paper and live accounts):
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Optional: AI Financial Copilot Free API Keys (Leave blank to use built-in quant engine)
# Google AI Studio (Free Gemini 1.5/2.0 Flash: https://aistudio.google.com)
GEMINI_API_KEY=
# Groq Console (Free LLaMA 3.3 70B: https://console.groq.com)
GROQ_API_KEY=
# OpenRouter (Free models: https://openrouter.ai)
OPENROUTER_API_KEY=
